<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="1Password Credentials Provider">
    <f:entry title="Expose 1Password items as Jenkins credentials" field="enabled">
      <f:checkbox/>
    </f:entry>
    <f:entry title="Vault" field="vault">
      <f:textbox/>
    </f:entry>
    <f:entry title="Tag" field="tag">
      <f:textbox/>
    </f:entry>
    <f:entry title="Cache the item listing" field="cache">
      <f:checkbox default="true"/>
    </f:entry>
  </f:section>
</j:jelly>
